# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# Test / tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# OS
.DS_Store

# NeoBrowser runtime state (never commit user sessions/cookies)
#
# These are anchored with a leading slash on purpose. Unanchored, `sessions/` matches a
# directory of that name at ANY depth — including `rust/src/sessions/`, which is source. That
# happened: splitting sessions.rs into modules produced four files git silently refused to
# add, so the tree built and tested locally while the pushed branch did not compile at all.
# `profiles/` was the same mine waiting for whoever split that module next.
.neorender/
*.cookies.json
/sessions/
/profiles/

# Private optional plugins (e.g. gpt/grok chat) — never part of the public repo
neobrowser/_private_*.py

# Debris from benchmark runs against Playwright MCP: its trace/console logs land here and
# are per-run artifacts, not source.
.playwright-mcp/

# Staged upload copies and trace bundles live under NEOBROWSER_HOME, but a test that sets
# it to a relative path would drop them here.
upload-staging/
traces/
